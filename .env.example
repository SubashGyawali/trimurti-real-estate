# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: required for Vercel webhook upsert (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Configuration (server-only, not exposed to browser)
ADMIN_EMAIL=admin@example.com

# Legacy direct worker (D:\Projects\instagram-ai-agent direct POSTs to /api/instagram/comments)
INSTAGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Vercel permanent webhook — Meta hub.verify_token + app secret
# META_VERIFY_TOKEN must match D:\Projects\instagram-ai-agent\.env META_VERIFY_TOKEN
META_VERIFY_TOKEN=replace-with-same-as-agent-VERIFY_TOKEN
# Optional: Meta App Secret for X-Hub-Signature-256 verification
META_APP_SECRET=replace-with-meta-app-secret-optional

# Email Configuration (Resend)
RESEND_API_KEY=re_123456789
FROM_EMAIL=onboarding@resend.dev

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=trimurti/properties

# Node Environment
# NODE_ENV=development

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
